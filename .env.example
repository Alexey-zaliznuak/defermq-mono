# DeferMQ использует один файл .env для Compose. Общие значения (PostgreSQL,
# NATS, hot horizon, payload limit и prefixes) должны совпадать у всех трёх
# бинарей. Длительности задаются в формате Go: 500ms, 2s, 5m, 24h.
# Значения ниже пригодны только для локального demo; замените пароли в production.

# Окружение приложения: development, staging или production.
DEFERMQ_ENV=development
# Имя сервиса; Compose переопределяет его отдельно для каждого бинаря.
DEFERMQ_SERVICE_NAME=defermq
# Необязательный уникальный ID процесса; пустое значение создаётся автоматически.
DEFERMQ_INSTANCE_ID=
# Уровень zap-логирования: debug, info, warn или error.
DEFERMQ_LOG_LEVEL=info
# Формат zap-логов: json или console.
DEFERMQ_LOG_FORMAT=json
# Начиная с этого уровня zap добавляет stack trace.
DEFERMQ_LOG_STACKTRACE_LEVEL=error
# Включает sampling повторяющихся логов.
DEFERMQ_LOG_SAMPLING_ENABLED=true
# Максимальное время корректного завершения процесса.
DEFERMQ_SHUTDOWN_TIMEOUT=20s
# Интервал до deliver_at, на котором сообщение попадает в быстрый индекс Valkey.
DEFERMQ_HOT_HORIZON=10s
# Максимальный размер payload в байтах; 1048576 соответствует 1 MiB.
DEFERMQ_MAX_PAYLOAD_BYTES=1048576
# Разрешённые Gateway типы назначения через запятую; core demo включает HTTP.
DEFERMQ_ENABLED_DESTINATIONS=http

# Обязательный DSN основной PostgreSQL — единственного source of truth.
DEFERMQ_POSTGRES_DSN=postgres://defermq:defermq@postgres:5432/defermq?sslmode=disable
# Максимальное число соединений основного пула.
DEFERMQ_POSTGRES_MAX_CONNS=30
# Минимальное число соединений основного пула.
DEFERMQ_POSTGRES_MIN_CONNS=2
# Максимальное время жизни соединения.
DEFERMQ_POSTGRES_MAX_CONN_LIFETIME=1h
# Максимальное время простоя соединения.
DEFERMQ_POSTGRES_MAX_CONN_IDLE_TIME=15m
# Интервал фоновой проверки соединений.
DEFERMQ_POSTGRES_HEALTH_CHECK_PERIOD=30s
# Таймаут установления соединения.
DEFERMQ_POSTGRES_CONNECT_TIMEOUT=5s
# Таймаут обычного SQL-запроса.
DEFERMQ_POSTGRES_QUERY_TIMEOUT=5s
# Таймаут SQL-запроса фонового сборщика метрик.
DEFERMQ_POSTGRES_METRICS_QUERY_TIMEOUT=3s
# Применять встроенные goose-миграции при старте.
DEFERMQ_POSTGRES_AUTO_MIGRATE=true

# Обязательный URL NATS; может содержать список серверов через запятую.
DEFERMQ_NATS_URL=nats://nats:4222
# Необязательное имя подключения; пустое формируется сервисом.
DEFERMQ_NATS_NAME=
# Таймаут подключения к NATS.
DEFERMQ_NATS_CONNECT_TIMEOUT=5s
# Пауза между переподключениями.
DEFERMQ_NATS_RECONNECT_WAIT=1s
# Число переподключений; -1 означает без ограничения до shutdown.
DEFERMQ_NATS_MAX_RECONNECTS=-1
# Таймаут ожидания JetStream PubAck.
DEFERMQ_NATS_PUBLISH_TIMEOUT=5s
# Имя stream готовых к доставке событий. В нём нет payload и scheduled events.
DEFERMQ_NATS_STREAM=DEFERMQ
# Число реплик stream; для локального одного NATS используется 1.
DEFERMQ_NATS_STREAM_REPLICAS=1
# Срок хранения сообщений в stream.
DEFERMQ_NATS_STREAM_MAX_AGE=24h
# Максимальный объём stream в байтах; пример — 1 GiB.
DEFERMQ_NATS_STREAM_MAX_BYTES=1073741824
# Максимальный размер NATS event в байтах; payload в NATS не передаётся.
DEFERMQ_NATS_STREAM_MAX_MSG_SIZE=65536
# Окно дедупликации Nats-Msg-Id.
DEFERMQ_NATS_DUPLICATE_WINDOW=10m
# Технический prefix старого scheduled subject. Новая схема не публикует в него
# сообщения: расписание хранится в PostgreSQL и Valkey.
DEFERMQ_NATS_SCHEDULE_SUBJECT_PREFIX=defermq.schedule
# Prefix ready subjects для Pusher.
DEFERMQ_NATS_READY_SUBJECT_PREFIX=defermq.ready
# Durable stream команд Gateway -> PostgreSQL batch writer.
DEFERMQ_NATS_INGEST_STREAM=DEFERMQ_INGEST_V2
# Базовый subject ingest; Gateway добавляет один из 32 стабильных shard suffix.
DEFERMQ_NATS_INGEST_SUBJECT=defermq.ingest.v2.commands
# NATS KV с временным pending-состоянием для read-after-write API.
DEFERMQ_NATS_INGEST_PENDING_BUCKET=DEFERMQ_INGEST_PENDING
# Максимальный размер ingest command. Он включает payload и JSON envelope.
DEFERMQ_NATS_INGEST_MAX_MSG_SIZE=3145728
# Необязательный пользователь NATS; не сочетайте с CREDS_FILE.
DEFERMQ_NATS_USER=
# Необязательный пароль NATS; не храните реальный секрет в git.
DEFERMQ_NATS_PASSWORD=
# Необязательный путь к NATS credentials внутри контейнера.
DEFERMQ_NATS_CREDS_FILE=
# Необязательный путь к CA для TLS NATS.
DEFERMQ_NATS_TLS_CA_FILE=
# Необязательный путь к клиентскому TLS-сертификату NATS.
DEFERMQ_NATS_TLS_CERT_FILE=
# Необязательный путь к клиентскому TLS-ключу NATS.
DEFERMQ_NATS_TLS_KEY_FILE=
# Необязательное ожидаемое TLS-имя сервера NATS.
DEFERMQ_NATS_TLS_SERVER_NAME=

# URL восстанавливаемого Valkey hot index.
DEFERMQ_VALKEY_URL=redis://valkey:6379/0
# Имя клиента в Valkey.
DEFERMQ_VALKEY_CLIENT_NAME=defermq-postgres-manager
# Размер connection pool Valkey.
DEFERMQ_VALKEY_POOL_SIZE=32
# Число стабильных bucket hot index.
DEFERMQ_VALKEY_BUCKETS=32
# Prefix ключей Valkey.
DEFERMQ_VALKEY_PREFIX=defermq:hot
DEFERMQ_VALKEY_DIAL_TIMEOUT=5s
DEFERMQ_VALKEY_READ_TIMEOUT=3s
DEFERMQ_VALKEY_WRITE_TIMEOUT=3s

# Адрес публичного HTTP API Gateway.
DEFERMQ_GATEWAY_HTTP_ADDR=:8080
# Таймаут чтения запроса Gateway.
DEFERMQ_GATEWAY_READ_TIMEOUT=10s
# Таймаут чтения HTTP-заголовков Gateway.
DEFERMQ_GATEWAY_READ_HEADER_TIMEOUT=5s
# Таймаут записи ответа Gateway.
DEFERMQ_GATEWAY_WRITE_TIMEOUT=15s
# Таймаут idle keep-alive соединения Gateway.
DEFERMQ_GATEWAY_IDLE_TIMEOUT=60s
# Общий timeout обработки API-запроса.
DEFERMQ_GATEWAY_REQUEST_TIMEOUT=10s
# Максимальный размер HTTP-заголовков Gateway в байтах.
DEFERMQ_GATEWAY_MAX_HEADER_BYTES=1048576
# Число попыток доставки по умолчанию.
DEFERMQ_GATEWAY_DEFAULT_MAX_ATTEMPTS=10
# Максимальная длина Idempotency-Key в байтах.
DEFERMQ_GATEWAY_MAX_IDEMPOTENCY_KEY_BYTES=200
# До скольких ingest commands Gateway собирает перед асинхронной публикацией.
DEFERMQ_GATEWAY_INGEST_BATCH_SIZE=100
# Максимальное ожидание заполнения ingest batch.
DEFERMQ_GATEWAY_INGEST_FLUSH_INTERVAL=100ms
# Локальная очередь Gateway перед публикацией в JetStream.
DEFERMQ_GATEWAY_INGEST_QUEUE_CAPACITY=1000
# Стабильные shards сохраняют порядок команд одной delivery.
DEFERMQ_GATEWAY_INGEST_SHARDS=32

# Адрес admin HTTP-сервера Manager.
DEFERMQ_MANAGER_HTTP_ADDR=:8081
# Число candidates в одном promoter batch.
DEFERMQ_MANAGER_PROMOTER_BATCH_SIZE=1000
# Пауза после неполного promoter batch.
DEFERMQ_MANAGER_PROMOTER_POLL_INTERVAL=500ms
# Ограниченная пауза promoter после ошибки.
DEFERMQ_MANAGER_PROMOTER_ERROR_BACKOFF=1s
# Число параллельных outbox publishers.
DEFERMQ_MANAGER_OUTBOX_WORKERS=4
# Максимальный размер claim одного outbox batch.
DEFERMQ_MANAGER_OUTBOX_BATCH_SIZE=200
# Пауза при пустом outbox.
DEFERMQ_MANAGER_OUTBOX_POLL_INTERVAL=100ms
# Срок lease взятой outbox-записи.
DEFERMQ_MANAGER_OUTBOX_LOCK_TTL=30s
# Начальная задержка повтора NATS publish.
DEFERMQ_MANAGER_OUTBOX_RETRY_INITIAL=250ms
# Максимальная задержка повтора NATS publish.
DEFERMQ_MANAGER_OUTBOX_RETRY_MAX=30s
# Durable consumer команд ingest.
DEFERMQ_MANAGER_INGEST_DURABLE=defermq-ingest-writer
# Число параллельных ingest writer consumers; каждый получает shard%workers.
DEFERMQ_MANAGER_INGEST_WORKERS=8
# Число ingest shards; должно совпадать с DEFERMQ_GATEWAY_INGEST_SHARDS.
DEFERMQ_MANAGER_INGEST_SHARDS=32
# Одноразовая миграция старого wildcard durable. Сначала остановите все Manager
# старой версии, затем включите на один запуск и после успешного старта выключите.
DEFERMQ_MANAGER_INGEST_DELETE_LEGACY_DURABLE=false
# Максимум ingest commands в одной транзакции PostgreSQL.
DEFERMQ_MANAGER_INGEST_BATCH_SIZE=500
# Максимальное ожидание неполного batch.
DEFERMQ_MANAGER_INGEST_FLUSH_INTERVAL=500ms
# Время до повторной выдачи команды без ACK.
DEFERMQ_MANAGER_INGEST_ACK_WAIT=30s
# Максимум ingest commands, ожидающих ACK.
DEFERMQ_MANAGER_INGEST_MAX_ACK_PENDING=2000
# После этого числа неуспешных обработок команда переносится в ingest DLQ.
DEFERMQ_MANAGER_INGEST_MAX_DELIVER=20
# Число registrar workers transactional hot_register outbox.
DEFERMQ_MANAGER_REGISTRAR_WORKERS=6
DEFERMQ_MANAGER_REGISTRAR_BATCH_SIZE=200
DEFERMQ_MANAGER_REGISTRAR_POLL_INTERVAL=100ms
DEFERMQ_MANAGER_REGISTRAR_LOCK_TTL=30s
# Число scheduler goroutines; bucket leases координируют экземпляры Manager.
DEFERMQ_MANAGER_SCHEDULER_WORKERS=10
DEFERMQ_MANAGER_SCHEDULER_POLL_INTERVAL=25ms
DEFERMQ_MANAGER_SCHEDULER_LEASE_TTL=30s
DEFERMQ_MANAGER_SCHEDULER_INFLIGHT_TTL=10s
DEFERMQ_MANAGER_SCHEDULER_PUBLISH_TIMEOUT=5s
DEFERMQ_MANAGER_SCHEDULER_EARLY_WINDOW=50ms
DEFERMQ_MANAGER_SCHEDULER_BATCH_SIZE=200
DEFERMQ_MANAGER_SCHEDULER_RECLAIM_BATCH_SIZE=200
DEFERMQ_MANAGER_SCHEDULER_ERROR_BACKOFF=250ms
# Периодическая сверка будущего hot horizon с PostgreSQL.
DEFERMQ_MANAGER_REPAIR_INTERVAL=5s
DEFERMQ_MANAGER_REPAIR_BATCH_SIZE=1000
# Интервал поиска просроченных deliveries.
DEFERMQ_MANAGER_OVERDUE_INTERVAL=1s
# Grace period перед overdue reconciliation.
DEFERMQ_MANAGER_OVERDUE_GRACE=15s
# Максимум overdue deliveries за batch.
DEFERMQ_MANAGER_OVERDUE_BATCH_SIZE=1000
# Интервал поиска истёкших processing leases.
DEFERMQ_MANAGER_REAPER_INTERVAL=5s
# Задержка повторной постановки после истечения lease.
DEFERMQ_MANAGER_RECOVERY_DELAY=0s
# Интервал retention cleanup.
DEFERMQ_MANAGER_RETENTION_INTERVAL=10m
# Срок хранения terminal deliveries.
DEFERMQ_MANAGER_TERMINAL_RETENTION=168h
# Срок хранения опубликованных outbox-записей.
DEFERMQ_MANAGER_OUTBOX_RETENTION=24h
# Максимум удаляемых записей за retention batch.
DEFERMQ_MANAGER_RETENTION_BATCH_SIZE=1000
# Интервал обновления DB-derived метрик Manager.
DEFERMQ_MANAGER_METRICS_COLLECTION_INTERVAL=5s
# Время запуска, в течение которого readyz не требует heartbeat критических loops.
DEFERMQ_MANAGER_LOOP_HEALTH_STARTUP_GRACE=30s
# Максимальный возраст последнего успешного цикла критического loop.
DEFERMQ_MANAGER_LOOP_HEALTH_MAX_STALENESS=20s

# Адрес admin HTTP-сервера Pusher.
DEFERMQ_PUSHER_HTTP_ADDR=:8082
# Pusher не ждёт WAL fsync для claim/completion: сбой может дать безопасный
# at-least-once duplicate, но не потерю delivery. Ingest всегда остаётся sync.
DEFERMQ_PUSHER_POSTGRES_SYNCHRONOUS_COMMIT=off
# Максимум ready events за один fetch.
DEFERMQ_PUSHER_FETCH_BATCH_SIZE=100
# Максимальное ожидание одного pull fetch.
DEFERMQ_PUSHER_FETCH_MAX_WAIT=2s
# Максимум ready events в одном атомарном PostgreSQL claim.
DEFERMQ_PUSHER_CLAIM_BATCH_SIZE=100
# Максимальное время накопления неполного claim microbatch.
DEFERMQ_PUSHER_CLAIM_FLUSH_INTERVAL=10ms
# Число HTTP workers.
DEFERMQ_PUSHER_WORKERS_HTTP=32
# Число Kafka workers.
DEFERMQ_PUSHER_WORKERS_KAFKA=8
# Число RabbitMQ workers.
DEFERMQ_PUSHER_WORKERS_RABBIT=8
# Число target PostgreSQL workers.
DEFERMQ_PUSHER_WORKERS_POSTGRES=16
# AckWait durable consumers; должно превышать обычную попытку.
DEFERMQ_PUSHER_ACK_WAIT=2m
# Максимум неподтверждённых events на consumer.
DEFERMQ_PUSHER_MAX_ACK_PENDING=5000
# Максимум JetStream redeliveries poison/unacked event.
DEFERMQ_PUSHER_MAX_DELIVER=20
# Длительность ownership lease в PostgreSQL.
DEFERMQ_PUSHER_PROCESSING_LEASE=60s
# Интервал продления processing lease.
DEFERMQ_PUSHER_LEASE_HEARTBEAT_INTERVAL=20s
# Допустимое расхождение часов без ранней отправки.
DEFERMQ_PUSHER_CLOCK_SKEW_TOLERANCE=10ms
# Начальная задержка application retry.
DEFERMQ_PUSHER_RETRY_INITIAL_BACKOFF=1s
# Множитель exponential backoff.
DEFERMQ_PUSHER_RETRY_MULTIPLIER=2
# Максимальная задержка application retry.
DEFERMQ_PUSHER_RETRY_MAX_BACKOFF=15m
# Вид jitter: full, equal или none.
DEFERMQ_PUSHER_RETRY_JITTER=full
# Интервал обновления фоновых метрик Pusher.
DEFERMQ_PUSHER_METRICS_COLLECTION_INTERVAL=5s

# Общий timeout HTTP push.
DEFERMQ_HTTP_PUSH_TIMEOUT=15s
# Таймаут TCP dial HTTP adapter.
DEFERMQ_HTTP_DIAL_TIMEOUT=3s
# Таймаут TLS handshake HTTP adapter.
DEFERMQ_HTTP_TLS_HANDSHAKE_TIMEOUT=5s
# Таймаут ожидания response headers.
DEFERMQ_HTTP_RESPONSE_HEADER_TIMEOUT=10s
# Максимальный idle timeout transport.
DEFERMQ_HTTP_IDLE_CONN_TIMEOUT=90s
# Максимум idle HTTP connections.
DEFERMQ_HTTP_MAX_IDLE_CONNS=1000
# Максимум idle connections на host.
DEFERMQ_HTTP_MAX_IDLE_CONNS_PER_HOST=200
# Максимум байтов response body для диагностики.
DEFERMQ_HTTP_MAX_RESPONSE_BODY_BYTES=65536
# Demo разрешает private IP. В production ставьте false и используйте allowlist:
# true допускает SSRF к внутренним сервисам, а DNS rebinding полностью не устраняется.
DEFERMQ_HTTP_ALLOW_PRIVATE_NETWORKS=true
# Необязательный allowlist HTTP hosts через запятую.
DEFERMQ_HTTP_ALLOWED_HOSTS=

# Включает Kafka adapter; также запустите Compose с --profile kafka.
DEFERMQ_KAFKA_ENABLED=false
# Kafka brokers через запятую.
DEFERMQ_KAFKA_BROKERS=kafka:9092
# Client ID Kafka producer.
DEFERMQ_KAFKA_CLIENT_ID=defermq
# Необязательный allowlist topics через запятую.
DEFERMQ_KAFKA_ALLOWED_TOPICS=
# Таймаут подключения Kafka.
DEFERMQ_KAFKA_DIAL_TIMEOUT=5s
# Таймаут Kafka produce request.
DEFERMQ_KAFKA_REQUEST_TIMEOUT=15s
# Включает TLS Kafka.
DEFERMQ_KAFKA_TLS_ENABLED=false
# Необязательный путь к CA Kafka.
DEFERMQ_KAFKA_TLS_CA_FILE=
# Необязательный путь к клиентскому сертификату Kafka.
DEFERMQ_KAFKA_TLS_CERT_FILE=
# Необязательный путь к клиентскому ключу Kafka.
DEFERMQ_KAFKA_TLS_KEY_FILE=
# Необязательный SASL-механизм, например SCRAM-SHA-256.
DEFERMQ_KAFKA_SASL_MECHANISM=
# Необязательный SASL username.
DEFERMQ_KAFKA_SASL_USERNAME=
# Необязательный SASL password; задавайте через secret manager.
DEFERMQ_KAFKA_SASL_PASSWORD=

# Включает RabbitMQ adapter; также запустите Compose с --profile rabbit.
DEFERMQ_RABBIT_ENABLED=false
# AMQP URL. Demo credential обязательно замените в production.
DEFERMQ_RABBIT_URL=amqp://guest:guest@rabbitmq:5672/
# Необязательный allowlist exchanges через запятую.
DEFERMQ_RABBIT_ALLOWED_EXCHANGES=
# Таймаут подключения RabbitMQ.
DEFERMQ_RABBIT_CONNECT_TIMEOUT=5s
# Таймаут publish и publisher confirm.
DEFERMQ_RABBIT_PUBLISH_TIMEOUT=15s
# Начальная задержка reconnect.
DEFERMQ_RABBIT_RECONNECT_INITIAL=500ms
# Максимальная задержка reconnect.
DEFERMQ_RABBIT_RECONNECT_MAX=30s
# Включает mandatory publish.
DEFERMQ_RABBIT_MANDATORY=false

# Включает target PostgreSQL adapter; запустите профиль target-postgres.
DEFERMQ_TARGET_POSTGRES_ENABLED=false
# DSN отдельной целевой БД, не source PostgreSQL.
DEFERMQ_TARGET_POSTGRES_DSN=postgres://target:target@target-postgres:5432/target?sslmode=disable
# Имя фиксированной таблицы target adapter.
DEFERMQ_TARGET_POSTGRES_TABLE=defermq_messages
# Создать target table при старте; удобно для demo, выключайте в production.
DEFERMQ_TARGET_POSTGRES_AUTO_CREATE_TABLE=true
# Максимальный размер target pool.
DEFERMQ_TARGET_POSTGRES_MAX_CONNS=10
# Таймаут target INSERT.
DEFERMQ_TARGET_POSTGRES_QUERY_TIMEOUT=10s

# Включает Prometheus endpoint и custom metrics.
DEFERMQ_METRICS_ENABLED=true
# Включает /debug/pprof на admin HTTP server; не публикуйте его без защиты.
DEFERMQ_PPROF_ENABLED=false

# Валидный placeholder готового Gateway image; замените перед production pull.
DEFERMQ_GATEWAY_IMAGE=registry.example.com/your-project/defermq-gateway:replace-me
# Валидный placeholder готового Manager image; замените перед production pull.
DEFERMQ_POSTGRES_MANAGER_IMAGE=registry.example.com/your-project/defermq-postgres-manager:replace-me
# Валидный placeholder готового Pusher image; замените перед production pull.
DEFERMQ_PUSHER_IMAGE=registry.example.com/your-project/defermq-pusher:replace-me
# Версия, встраиваемая build-вариантом через ldflags.
DEFERMQ_VERSION=dev
# Git commit, встраиваемый build-вариантом через ldflags.
DEFERMQ_COMMIT=unknown
# Время сборки RFC3339, встраиваемое через ldflags.
DEFERMQ_BUILD_TIME=unknown

# Имя source PostgreSQL database для локального Compose.
POSTGRES_DB=defermq
# Пользователь source PostgreSQL для локального Compose.
POSTGRES_USER=defermq
# Demo-пароль source PostgreSQL; обязательно замените вне локальной машины.
POSTGRES_PASSWORD=defermq
# Имя target PostgreSQL database для optional profile.
TARGET_POSTGRES_DB=target
# Пользователь target PostgreSQL для optional profile.
TARGET_POSTGRES_USER=target
# Demo-пароль target PostgreSQL; обязательно замените вне локальной машины.
TARGET_POSTGRES_PASSWORD=target
# Порт source PostgreSQL на loopback host для integration tests.
DEFERMQ_POSTGRES_PORT=55432
# Порт optional target PostgreSQL на loopback host.
DEFERMQ_TARGET_POSTGRES_PORT=5433
# Порт Gateway на loopback host.
DEFERMQ_GATEWAY_PORT=8080
# Порт Manager admin API на loopback host.
DEFERMQ_MANAGER_PORT=8081
# Порт Pusher admin API на loopback host.
DEFERMQ_PUSHER_PORT=8082
# Клиентский порт NATS на loopback host.
DEFERMQ_NATS_CLIENT_PORT=4222
# Monitoring port NATS на loopback host.
DEFERMQ_NATS_MONITORING_PORT=8222
# Порт Valkey на loopback host.
DEFERMQ_VALKEY_PORT=56379
# Management UI RabbitMQ на loopback host.
DEFERMQ_RABBIT_MANAGEMENT_PORT=15672

# --- Opt-in integration tests (обычный запуск оставляет значения пустыми) ---
# DSN PostgreSQL, в которой тест может создавать и удалять временные схемы.
DEFERMQ_TEST_POSTGRES_DSN=
# URL NATS Server 2.12+ с включённым JetStream.
DEFERMQ_NATS_INTEGRATION_URL=
# Kafka brokers и заранее созданный topic для integration test.
DEFERMQ_TEST_KAFKA_BROKERS=
DEFERMQ_TEST_KAFKA_TOPIC=
# RabbitMQ URL, exchange и routing key для integration test.
DEFERMQ_TEST_RABBIT_URL=
DEFERMQ_TEST_RABBIT_EXCHANGE=
DEFERMQ_TEST_RABBIT_ROUTING_KEY=
# DSN отдельной target PostgreSQL для проверки идемпотентного adapter insert.
DEFERMQ_TEST_TARGET_POSTGRES_DSN=
# URL запущенного Gateway для полного локального HTTP E2E.
DEFERMQ_E2E_GATEWAY_URL=
# Host receiver-а, доступный Pusher из Docker Desktop.
DEFERMQ_E2E_RECEIVER_PUBLIC_HOST=host.docker.internal
